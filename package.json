{
  "name": "crisp-annotations",
  "version": "1.6.0",
  "description": "Hand-drawn inline annotations for Obsidian Markdown.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "lint": "eslint src tests *.ts *.mjs --no-error-on-unmatched-pattern",
    "check": "npm run test && npm run lint && npm run build"
  },
  "keywords": [
    "obsidian",
    "annotations",
    "highlights",
    "margin-notes"
  ],
  "author": "小红书 letschips",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "obsidian": "^1.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
